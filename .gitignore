# Dependencies / build outputs — regenerated by each repo's own setup, never committed.
node_modules/
.venv/
venv/
__pycache__/
*.pyc
target/
Pods/
DerivedData/
.build/
.swiftpm/
xcuserdata/
*.xcuserstate

# Generic build-output rule — EXCEPT the contract-mandated source path apps/mobile/src/build/.
# A bare `build/` rule here silently swallowed real source in the upstream orb repo before
# (see FLEET-LEARNINGS.md and ORB-AND-FLEET-DELTA.md, C3 "atomizer" row) — do not repeat it.
build/
!orb/apps/mobile/src/build/
!orb/apps/mobile/src/build/**
dist/
.next/
coverage/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store

# git worktree checkouts — never track these from the main checkout
.worktrees/
