+    /// that can bound this call from the relay's side is `main.rs`'s own timeout.
+    struct HangingStt;
+
+    impl SttProvider for HangingStt {
+        fn push_audio(
+            &self,
+            _session_id: &str,
+            _frame: &[u8],
+            _cancel: &dyn CancelSignal,
