{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/receipt.v1.json",
  "title": "Receipt — one append-only ledger row",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","seq","prev_hash","hash","ts_wall","event","actor","body"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "seq":       {"type": "integer", "minimum": 0},
    "prev_hash": {"type": "string", "pattern": "^(GENESIS|blake3:[0-9a-f]{64})$"},
    "hash":      {"type": "string", "pattern": "^blake3:[0-9a-f]{64}$"},
    "ts_wall":   {"type": "string", "format": "date-time",
                  "description": "STAMPED BY THE LEDGER. Never supplied by a worker."},
    "event":     {"type": "string", "enum": ["run_start","artifact_frozen","attested","refusal","gate_verdict","run_end","lane_status"]},
    "actor":     {"type": "string",
                  "description": "STAMPED BY THE LAUNCHER from the argv it built. Never declared by the launched."},
    "resolved_model": {"type": ["string","null"], "description": "read back from the harness; null = not-applicable"},
    "exit_code": {"type": ["integer","null"]},
    "body":      {"type": "object", "description": "the only part a worker authors"}
  }
}
