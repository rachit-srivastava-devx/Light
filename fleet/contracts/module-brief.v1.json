{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/module-brief.v1.json",
  "title": "module-brief.v1 — the proposer-authored half (F02 lane contract §5.1; blueprint 02 §2.2)",
  "description": "AUTHORED. Ported from orb/contracts/lld.v1.json (schema ownership moved fleet-ward, F02 lane contract §3.1: the lld-ready gate is fleet's, so the schema the gate refuses against must not live with the proposer). Everything on moduleBrief is content; none of it is authority — content_hash/freeze_id/depth_evidence/stamped_by/state/version are absent by design, not merely optional, and additionalProperties:false makes their presence a schema violation, not a silently-ignored extra key. INVARIANT (hashing): no property of moduleBrief or any of its $defs may be type 'number' or 'integer'. content_hash is computed over canonical_json(module_brief); the canonicalizer REFUSES numbers (freeze.v1 §hashing) because JSON number encoding diverges across languages -- JSON.stringify(1.0)==='1' in JS, json.dumps(1.0)=='1.0' in Python, serde_json 1.0f64 -> '1.0' in Rust. Adding a numeric field here silently splits the hash three ways. If one is ever required, see the RFC 8785 revive trigger in the F02 lane contract §3.6.",
  "$defs": {
    "grain": { "enum": ["module", "leaf"], "description": "Descriptive metadata only, no authority -- it must never lower the alternatives floor (F02 §3.4). A proposer-authored field is never allowed to self-exempt from a depth requirement." },
    "registryVerdict": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "matched_path"],
          "properties": {
            "kind": { "const": "install" },
            "matched_path": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "matched_path"],
          "properties": {
            "kind": { "const": "extract" },
            "matched_path": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "searched"],
          "properties": {
            "kind": { "const": "build_new" },
            "searched": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
          }
        }
      ]
    },
    "derivation": {
      "description": "R17: a claim carries its working, or names what it makes unrepresentable. Nothing else.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "calc"],
          "properties": {
            "kind": { "const": "number" },
            "value": { "type": "string" },
            "calc": { "type": "string", "minLength": 1, "pattern": "[0-9]" },
            "source": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "invariant", "enforced_by"],
          "properties": {
            "kind": { "const": "structural" },
            "invariant": { "type": "string", "minLength": 1 },
            "enforced_by": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "guarantee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "derivation", "label"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "derivation": { "$ref": "#/$defs/derivation" },
        "label": { "enum": ["kills_structural", "kills_mechanical", "mitigates"] }
      }
    },
    "killedAlt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option", "why_killed", "revive_trigger"],
      "properties": {
        "option": { "type": "string", "minLength": 1 },
        "why_killed": { "type": "string", "minLength": 1 },
        "revive_trigger": { "type": "string", "minLength": 1 }
      }
    },
    "failureStory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "blast_radius", "fail_safe"],
      "properties": {
        "trigger": { "type": "string", "minLength": 10 },
        "blast_radius": { "type": "string", "minLength": 10 },
        "fail_safe": { "type": "string", "minLength": 10 }
      }
    },
    "interfaceDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "signature"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 }
      }
    },
    "dataDecl": {
      "description": "owned_by_node MUST === the enclosing brief's node_id (checked cross-field, not expressible in plain JSON Schema).",
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "owned_by_node"],
      "properties": {
        "store": { "type": "string", "minLength": 1 },
        "owned_by_node": { "type": "string", "minLength": 1 }
      }
    },
    "acceptanceLine": {
      "description": "artifact must start with owner_path, and `then` must contain the artifact substring (C3-ACC-GROUND) — cross-field, checked by the validator/gate, not by this file alone.",
      "type": "object",
      "additionalProperties": false,
      "required": ["given", "when", "then", "oracle_kind", "artifact"],
      "properties": {
        "given": { "type": "string", "minLength": 3 },
        "when": { "type": "string", "minLength": 3 },
        "then": { "type": "string", "minLength": 3 },
        "oracle_kind": { "enum": ["test", "property", "metric"] },
        "artifact": { "type": "string", "minLength": 1 }
      }
    },
    "moduleBrief": {
      "description": "The proposer-authored half (AUTHORED). owner/acceptance.artifact are kept from the orb's copy (02 §2.2 lists neither, but 03 §4.1's freeze.owner/accepts_when.artifact must source from somewhere on the brief — do not \"fix\" this back out).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "node_id", "grain", "purpose", "owner", "owner_path", "interface",
        "data_owned", "deps", "registry", "acceptance", "non_goals", "open_questions", "guarantees",
        "alternatives", "failure_story"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "node_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "grain": { "$ref": "#/$defs/grain" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 200 },
        "owner": { "type": "string", "minLength": 1 },
        "owner_path": { "type": "string", "minLength": 1, "not": { "pattern": "\\.\\." } },
        "interface": { "type": "array", "items": { "$ref": "#/$defs/interfaceDecl" }, "minItems": 1 },
        "data_owned": { "type": "array", "items": { "$ref": "#/$defs/dataDecl" } },
        "deps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "registry": { "$ref": "#/$defs/registryVerdict" },
        "acceptance": { "$ref": "#/$defs/acceptanceLine" },
        "non_goals": { "type": "array", "items": { "type": "string" } },
        "open_questions": { "type": "array", "items": { "type": "string" } },
        "guarantees": { "type": "array", "items": { "$ref": "#/$defs/guarantee" }, "minItems": 1 },
        "alternatives": {
          "type": "array",
          "items": { "$ref": "#/$defs/killedAlt" },
          "minItems": 2,
          "description": "minItems:2 FLAT — no grain='leaf' exemption (F02 §3.4/§4.2: a proposer-authored field must never lower the R21 floor; the floor is in the schema, not a lint)."
        },
        "failure_story": { "$ref": "#/$defs/failureStory" }
      }
    }
  },
  "$ref": "#/$defs/moduleBrief"
}
