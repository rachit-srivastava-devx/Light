# CARGO_TARGET_DIR lives OUTSIDE the repo at ~/.cache/fleet-rs-target-shared (see tests/corpus/M2.sh D30)
# agent worktrees live INSIDE the repo, never beside it (owner rule 2026-08-24)
.codebase-memory/
.venv/
.worktrees/
node_modules/
output/
target/
target-shared/
var/

# cargo-mutants run output — regenerated, never reviewed, must not be tracked.
# cargo-mutants renames an existing run to mutants.out.old/ before starting the next one, so
# match any mutants.out* dir at any depth rather than just the literal current-run name.
**/mutants.out*/

# B11: cargo-llvm-cov (bin/coverage-report.sh) drops raw instrumentation counters here mid-run;
# they're consumed and merged into the report before this script exits, and are not useful alone.
*.profraw
