{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/attestation.v1.json",
  "title": "in-toto Statement carrying the fleet Delivery predicate",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type","subject","predicateType","predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name","digest"],
        "properties": {
          "name": {"type": "string"},
          "digest": {"type": "object", "required": ["blake3"],
                     "properties": {"blake3": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
        }
      }
    },
    "predicateType": {"const": "https://fleet.local/DeliveryAttestation/v1"},
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier","elements","receipts","builder"],
      "properties": {
        "tier": {"type": "string", "enum": ["T-min","T-std","T-max"]},
        "builder": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}},
        "elements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sow":          {"type": "object"},
            "blind_suite":  {"type": "object"},
            "independent_verification": {"type": "object"},
            "adequacy":     {"type": ["object","null"]},
            "blast_radius": {"type": "object"},
            "rollback":     {"type": ["object","null"]},
            "cost":         {"type": "object"},
            "oracle_independence": {"type": "object",
              "description": "element 8 - NON-DROPPABLE AT EVERY TIER (21 3.4)"}
          }
        },
        "receipts": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
