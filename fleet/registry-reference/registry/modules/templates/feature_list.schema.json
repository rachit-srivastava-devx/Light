{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://company-os/feature_list.schema.json",
  "title": "Feature ledger",
  "description": "The machine-readable done-ledger (PROBLEMS-PLAYBOOK #1). Builders may ONLY flip `passes` false->true, and ONLY after driving `steps` end-to-end. Editing/removing feature definitions is lead-only (hook-enforced).",
  "type": "object",
  "required": ["project", "features"],
  "additionalProperties": false,
  "properties": {
    "project": { "type": "string" },
    "episode": { "type": ["string", "number"] },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "description", "steps", "passes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "stable kebab-case id, e.g. tenancy-can-limit" },
          "category": { "enum": ["functional", "ui", "api", "ops"] },
          "description": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "end-to-end, executable by a user (browser for web, real CLI for CLIs)"
          },
          "module": { "type": "string", "description": "registry module or product slice this belongs to (C1)" },
          "priority": { "type": "integer", "minimum": 1 },
          "passes": { "type": "boolean" },
          "evidence": { "type": "string", "description": "path to var/evidence/<id>/report.md once verified" }
        }
      }
    }
  }
}
