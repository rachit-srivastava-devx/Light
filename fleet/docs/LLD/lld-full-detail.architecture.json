  "cards": [
    {
      "dot": "violet",
      "title": "Node tag = mistake risk, not code quality",
      "items": [
        "deterministic: code logic — bugs possible, judgment-call errors are not",
        "model, gated: a model proposes, a deterministic check or an independent reviewer catches disagreement before it has effect",
        "model, ungated: a model's output is trusted directly — the 4 probes are the only such nodes, and their output only ever produces questions or context, never a direct effect"
      ]
    },
    {
      "dot": "cyan",
      "title": "Trust zones (LLD §3)",
      "items": [
        "Operator-approved: controller, config, grants",
        "Immutable evidence: store, verify results, candidates",
        "Untrusted: worker output, retrieved content, external events",
        "No model writes the ledger, credentials, or policy directly"
      ]
    },
